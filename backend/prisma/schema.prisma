generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum Płeć
enum Gender {
  MEZCZYZNA
  KOBIETA
}

// Enum Rola użytkownika
enum Role {
  UZYTKOWNIK
  PRACOWNIK
  ADMINISTRATOR
}

// Model Użytkownika
model User {
  id               Int      @id @default(autoincrement())
  fullName         String  
  email            String   @unique 
  password         String   
  gender           Gender   @default(MEZCZYZNA) 
  role             Role     @default(UZYTKOWNIK) 

  phoneNumber      String?
  city             String? 
  postalCode       String? 
  street           String? 

  dateOfBirth      DateTime?
  hasChildren      Boolean  @default(false) 
  hasOtherAnimals  Boolean  @default(false) 
  isBanned         Boolean  @default(false)
  isFormFilled     Boolean  @default(false) 
  isEmailVerified  Boolean  @default(false)

  adminNote        String?  

  twoFactorEnabled Boolean @default(false) 
  twoFactorSecret  String? 
  emailVerificationCode    String?
  emailVerificationExpires DateTime? 

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt 

  imageUrl         String? 
  adoptions        Adoption[] 
  processedAdoptions Adoption[] @relation("processedBy") 
  dailyZoneAssignments DailyZoneAssignment[] 
  reportedAnimalNeeds AnimalNeed[] @relation("AnimalNeedReportedBy") 
}

// Enum typ zwierzęcia
enum AnimalType {
  PIES
  KOT
  KROLIK
  CHOMIK
  ZOLW
  INNE
}

// Enum płeć zwierzęcia
enum AnimalGender {
  SAMICA
  SAMIEC
}

// Enum rozmiar zwierzęcia
enum AnimalSize {
  MALY
  SREDNI
  DUZY
}

// Enum status zwierzęcia
enum AnimalStatus {
  SZUKA_DOMU
  ZNALEZIONY
  W_TRAKCIE_ADOPCJI
  ADOPTOWANY
}

// Enum stan zdrowia zwierzęcia
enum AnimalHealthStatus {
  ZDROWY
  CHORY
  ZARAŻONY
  POTRZEBUJE_OPERACJI
}

// Enum kategoria potrzeby zwierzęcia
enum AnimalNeedCategory {
  JEDZENIE   
  LEKI        
  WYPOSAZENIE 
  OPIEKA      
  INNE        
}

// Model Zwierzęcia
model Animal {
  id               Int           @id @default(autoincrement()) 
  name             String       
  type             AnimalType    @default(INNE) 
  gender           AnimalGender  @default(SAMIEC) 
  size             AnimalSize    @default(SREDNI) 
  traits           String      
  dateOfBirth      DateTime      
  description      String        
  cageId           Int?          @unique 
  cage             Cage?         @relation(fields: [cageId], references: [id], onDelete: SetNull)

  isSterilized            Boolean @default(false) 
  isVaccinated            Boolean @default(false) 
  isChildFriendly         Boolean @default(false) 
  isTrained               Boolean @default(false) 
  lovesPlay               Boolean @default(false) 
  lovesWalks              Boolean @default(false) 
  acceptsDogs             Boolean @default(false) 
  acceptsCats             Boolean @default(false) 
  lovesAffection          Boolean @default(false) 
  poorlyToleratesShelter  Boolean @default(false) 

  status           AnimalStatus  @default(ZNALEZIONY) 
  healthStatus     AnimalHealthStatus  @default(ZDROWY) 
  nextVisitDate    DateTime?     
  foundAt          DateTime      
  foundLocation    String       

  imageUrl         String[]      
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  adoptions        Adoption[]    
  medicalRecords   MedicalRecord[] 
  dailyCare        AnimalDailyCare[] 
  needs            AnimalNeed[] 
}

// Model Dziennej opieki zwierzęcia
model AnimalDailyCare {
  id          Int      @id @default(autoincrement()) 
  animalId    Int      
  date        DateTime

  fed         Boolean  @default(false) 
  watered     Boolean  @default(false) 
  cleaned     Boolean  @default(false) 
    
  fedAt       DateTime?
  wateredAt   DateTime? 
  cleanedAt   DateTime? 

  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([animalId, date])
  @@index([date])
}

// Model Potrzeby zwierzęcia
model AnimalNeed {
  id           Int                @id @default(autoincrement())
  animalId     Int                
  category     AnimalNeedCategory @default(INNE) 
  name         String             
  description  String?            
  isActive     Boolean            @default(true) 
  reportedById Int?               

  animal       Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  reportedBy   User?              @relation("AnimalNeedReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([animalId])
  @@index([reportedById])
  @@index([isActive])
}

// Model Klatki
model Cage {
  id      Int     @id @default(autoincrement()) 
  zone    String  
  number  Int     
  animal  Animal? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zone, number])
  @@index([zone])
}

// Model Przypisania strefy na dzień
model DailyZoneAssignment {
  id       Int      @id @default(autoincrement()) 
  date     DateTime 
  zone     String  
  workerId Int      
  worker   User     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, zone, workerId]) // Ten sam pracownik nie może mieć dwa razy tej samej strefy w danym dniu
  @@index([date])
  @@index([date, zone])
  @@index([workerId])
}

// Enum status adopcji
enum AdoptionStatus {
  OCZEKUJACA 
  ZAAKCEPTOWANA 
  ODRZUCONA 
  ANULOWANA 
  ZAKONCZONA 
}

// Model Adopcji
model Adoption {
  id          Int             @id @default(autoincrement()) // ID adopcji

  userId      Int 
  animalId    Int 
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade) 
  animal      Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade) 

  status      AdoptionStatus  @default(OCZEKUJACA) 

  message     String?         
  employeeNote String?       

  processedById Int? 
  processedBy User?            @relation(fields: [processedById], references: [id], name: "processedBy") 

  createdAt   DateTime        @default(now()) 
  updatedAt   DateTime        @updatedAt 
}

// Model Weterynarza
model Vet {
  id Int @id @default(autoincrement())
  name String
  phone String
  clinic String
  records MedicalRecord[]
}

// Enum typ rekordu medycznego
enum MedicalRecordType {
  WIZYTA 
  BADANIE 
  OPERACJA 
  SZCZEPIENIE 
  URAZ 
  INNE 
}

// Enum status rekordu medycznego
enum MedicalRecordStatus {
  DO_REALIZACJI 
  W_TRAKCIE 
  ZREALIZOWANA 
}

// Model Rekordu medycznego
model MedicalRecord {
  id Int @id @default(autoincrement()) // ID rekordu medycznego
  animalId Int 
  description String // Opis rekordu medycznego
  type MedicalRecordType // Typ rekordu medycznego

  vetId Int // Weterynarz
  vet Vet @relation(fields: [vetId], references: [id], onDelete: Cascade) // Weterynarz
  date DateTime // Data rekordu medycznego
  cost Float @default(0.00)// Koszt rekordu medycznego

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  status MedicalRecordStatus // Status rekordu medycznego

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Data aktualizacji
}

// Model Subskrybenta newslettera
model NewsletterSubscriber {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique
  consentAt        DateTime @default(now())
  createdAt        DateTime @default(now())
}

